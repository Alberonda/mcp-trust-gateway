{
  "name": "mcp-trust-gateway",
  "version": "0.1.0",
  "description": "MCP proxy adding an auth/permission/audit trust layer between agents and real MCP servers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/httpGateway/httpServer.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/httpGateway/httpServer.js",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "tsx --test src/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "test:e2e": "npm run build && tsx --test test/e2e/**/*.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "gpt-tokenizer": "3.4.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
