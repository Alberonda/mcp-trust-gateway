{
  "name": "mcp-trust-gateway",
  "version": "0.1.0",
  "description": "MCP proxy adding an auth/permission/audit trust layer between agents and real MCP servers",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/entrypoints/stdio/index.ts",
    "dev:http": "tsx watch src/entrypoints/http/httpServer.ts",
    "start": "node dist/entrypoints/stdio/index.js",
    "start:http": "node dist/entrypoints/http/httpServer.js",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "test:integration": "tsx --test $(find test/integration -name '*.test.ts')",
    "test:e2e": "npm run build && npm --prefix relay-agent run build && tsx --test $(find test/e2e -name '*.test.ts')",
    "test:all": "npm run typecheck && npm test && npm run test:integration"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "pg": "8.23.1",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "gpt-tokenizer": "3.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.0"
  }
}
